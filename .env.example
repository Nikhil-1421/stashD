# Copy to .env.local (git-ignored) and fill in values from your Supabase project:
# Supabase Dashboard -> Project Settings -> API. For local dev, `npm run db:start` prints them.
#
# Only the anon (public) key belongs here. NEVER put the service-role key in this file
# or anywhere the browser can read it.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public URL of this app, used for auth email redirects (verification, password reset).
VITE_APP_URL=http://localhost:5173
